<ui:FluentWindow
    x:Class="SteamStubber.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Steam Stubber"
    Width="340"
    MinWidth="300"
    MinHeight="220"
    SizeToContent="Height"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Steam Stubber" />

        <Grid Grid.Row="1" Margin="16,8,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Game" Margin="0,0,0,4" />
                <ComboBox Grid.Row="1" x:Name="CmbGames"
                          HorizontalAlignment="Stretch"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          StaysOpenOnEdit="True"
                          SelectionChanged="CmbGames_SelectionChanged"
                          DropDownOpened="CmbGames_DropDownOpened"
                          KeyDown="CmbGames_KeyDown" />

                <ui:Button Grid.Row="2" x:Name="BtnUnpack" Appearance="Primary" Content="Unpack"
                           HorizontalAlignment="Stretch"
                           Margin="0,10,0,0" Click="BtnUnpack_Click" />
                <ui:Button Grid.Row="5" x:Name="BtnRefresh" Content="Refresh"
                           HorizontalAlignment="Stretch"
                           Margin="0,6,0,0" Click="BtnRefresh_Click" />

                <TextBlock Grid.Row="7" x:Name="LblInstallPath" Opacity="0.65" FontSize="11"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Pick a game." />

                <ProgressBar Grid.Row="8" x:Name="ProgOverall" Height="10" Minimum="0" Maximum="100" Value="0"
                             Margin="0,8,0,0" />
                <TextBlock Grid.Row="9" x:Name="LblStatus" Margin="0,4,0,0" Text="Idle." />

                <ListBox Grid.Row="10" x:Name="FileBox" Margin="0,8,0,0"
                         MaxHeight="200" Visibility="Collapsed" />
        </Grid>

        <Border Grid.Row="2" Padding="16,5"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="LblSteamPath" Opacity="0.65" FontSize="11"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</ui:FluentWindow>
